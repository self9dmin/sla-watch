{
  "$schema": "https://developer.dynatrace.com/docs-assets/schema_strict_apps.json",
  "dynatrace": "1",
  "schemaId": "contract-overrides",
  "version": "1.1.0",
  "displayName": "SLA contract overrides",
  "description": "Tenant-owned operational terms that take precedence over public sla.directory records for an explicitly selected provider scope.",
  "documentation": "Store operational terms and a source reference only. Do not paste confidential contract text, credentials, or personal data. All authenticated users of this app can read these settings.",
  "multiObject": true,
  "maxObjects": 500,
  "summaryPattern": "{providerServiceName} · {scopeEntityName}",
  "searchPattern": "{providerSlug} {providerServiceName} {scopeKind} {scopeEntityName} {sourceReference}",
  "ordered": false,
  "maturity": "GENERAL_AVAILABILITY",
  "ownerBasedAccessControl": false,
  "enums": {
    "ScopeKind": {
      "type": "enum",
      "displayName": "Scope type",
      "items": [
        { "value": "provider", "displayName": "Provider default" },
        { "value": "service", "displayName": "Dynatrace service" },
        { "value": "host", "displayName": "Host or runtime" },
        { "value": "location", "displayName": "Cloud region or datacenter" }
      ]
    }
  },
  "properties": {
    "overrideKey": {
      "displayName": "Override key",
      "description": "Stable key generated by SLA Review from provider, service, and scope.",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "providerSlug": {
      "displayName": "Provider slug",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "providerServiceId": {
      "displayName": "Provider service ID",
      "type": "text",
      "default": "*",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "providerServiceName": {
      "displayName": "Provider service",
      "type": "text",
      "default": "All provider services",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "scopeKind": {
      "displayName": "Scope type",
      "type": { "$ref": "#/enums/ScopeKind" },
      "default": "provider",
      "nullable": false
    },
    "scopeEntityId": {
      "displayName": "Scope ID",
      "type": "text",
      "default": "*",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "scopeEntityName": {
      "displayName": "Scope name",
      "type": "text",
      "default": "Provider default",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "scopeEntityIds": {
      "displayName": "Evidence target IDs",
      "description": "Exact Dynatrace entity IDs or observed location values assigned to these custom terms.",
      "type": "set",
      "items": { "type": "text" },
      "default": [],
      "nullable": false,
      "maxObjects": 100
    },
    "scopeEntityNames": {
      "displayName": "Evidence target names",
      "description": "Display names captured when the evidence targets were assigned.",
      "type": "list",
      "items": { "type": "text" },
      "default": [],
      "nullable": false,
      "maxObjects": 100
    },
    "location": {
      "displayName": "Observed location",
      "description": "Cloud region, availability zone, or datacenter observed for the selected runtime.",
      "type": "text",
      "nullable": true
    },
    "availabilityTarget": {
      "displayName": "Availability target (%)",
      "type": "float",
      "nullable": true,
      "constraints": [{ "type": "RANGE", "minimum": 0, "maximum": 100 }]
    },
    "filingDeadlineDays": {
      "displayName": "Filing deadline (days)",
      "type": "integer",
      "nullable": true,
      "constraints": [{ "type": "RANGE", "minimum": 0, "maximum": 365 }]
    },
    "deadlineBasis": {
      "displayName": "Filing deadline basis",
      "description": "For example: incident end, incident start, billing cycle, or provider-defined.",
      "type": "text",
      "nullable": true
    },
    "businessDays": {
      "displayName": "Use business days",
      "type": "boolean",
      "default": false,
      "nullable": false
    },
    "maxCreditPercent": {
      "displayName": "Maximum credit (%)",
      "type": "float",
      "nullable": true,
      "constraints": [{ "type": "RANGE", "minimum": 0, "maximum": 100 }]
    },
    "claimMethod": {
      "displayName": "Claim method",
      "type": "text",
      "nullable": true
    },
    "effectiveFrom": {
      "displayName": "Effective from",
      "type": "local_date",
      "nullable": true
    },
    "effectiveTo": {
      "displayName": "Effective to",
      "type": "local_date",
      "nullable": true
    },
    "sourceReference": {
      "displayName": "Contract or amendment reference",
      "description": "A concise reference that lets an operator verify the custom term.",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "sourceUrl": {
      "displayName": "Source URL",
      "type": "text",
      "nullable": true
    },
    "notes": {
      "displayName": "Operational note",
      "description": "Do not paste confidential contract language.",
      "type": "text",
      "nullable": true
    },
    "enabled": {
      "displayName": "Enabled",
      "type": "boolean",
      "default": true,
      "nullable": false
    }
  }
}
