{
  "$schema": "https://developer.dynatrace.com/docs-assets/schema_strict_apps.json",
  "dynatrace": "1",
  "schemaId": "provider-scope-assignments",
  "version": "1.1.0",
  "displayName": "Provider coverage assignments",
  "description": "Operator-confirmed mappings between a Dynatrace service scope and provider terms.",
  "documentation": "Smartscape evidence can suggest a service-to-runtime mapping. Services without a usable relationship can be confirmed directly. Assignments identify applicable provider terms and do not establish provider fault, impact, or credit eligibility.",
  "multiObject": true,
  "maxObjects": 1000,
  "summaryPattern": "{serviceEntityName} · {providerServiceName}",
  "searchPattern": "{providerSlug} {providerServiceName} {serviceEntityName} {runtimeEntityName} {location}",
  "ordered": false,
  "maturity": "GENERAL_AVAILABILITY",
  "ownerBasedAccessControl": false,
  "properties": {
    "assignmentKey": {
      "displayName": "Assignment key",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "providerSlug": {
      "displayName": "Provider slug",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "providerServiceId": {
      "displayName": "Provider service ID",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "providerServiceName": {
      "displayName": "Provider service",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "serviceEntityId": {
      "displayName": "Dynatrace service ID",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "serviceEntityName": {
      "displayName": "Dynatrace service",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "runtimeEntityId": {
      "displayName": "Runtime ID",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "runtimeEntityName": {
      "displayName": "Runtime",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "runtimeType": {
      "displayName": "Runtime type",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "location": {
      "displayName": "Observed location",
      "type": "text",
      "nullable": true
    },
    "evidence": {
      "displayName": "Confirmation evidence",
      "type": "text",
      "default": "",
      "nullable": false,
      "constraints": [{ "type": "NOT_BLANK" }]
    },
    "enabled": {
      "displayName": "Enabled",
      "type": "boolean",
      "default": true,
      "nullable": false
    }
  }
}
